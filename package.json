{
  "name": "dsh-decision-gate",
  "version": "0.4.0",
  "description": "DSH PreToolUse gate: asks TypeSafe's Jev what kind of operation a tool call is and allows, asks, or denies it, with a path-scoped exemption that downgrades destructive denies to asks inside scratch prefixes.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./dsh/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "dsh",
    "docs",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:node": "node src/parity.ts",
    "test:func": "node tests/functional.mjs",
    "test:py": "python -m pytest tests/test_decision_gate.py tests/test_exempt.py tests/test_analyze.py -q",
    "check": "npm run typecheck && npm run test:func && npm run test:node && npm run test:py"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "jev",
    "typesafe",
    "gate",
    "pre-tool-use",
    "permission",
    "cordis",
    "plugin"
  ],
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "undici": ">=6.0.0 <8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}